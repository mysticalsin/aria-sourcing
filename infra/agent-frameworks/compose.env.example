# Secret-free Docker Compose inputs for one ARIA workspace. Copy this file to
# an operator-owned location outside Git, fill every immutable identity, and
# point each *_FILE variable at a file materialized by the secret manager.

ARIA_WORKSPACE_ID=
AGENT_FRAMEWORK_CONFIGURATION_SHA256=

FRAMEWORK_ADAPTER_IMAGE_REPOSITORY=
FRAMEWORK_ADAPTER_IMAGE_SHA256=
REDIS_IMAGE_REPOSITORY=
REDIS_IMAGE_SHA256=
DEERFLOW_POSTGRES_IMAGE_REPOSITORY=
DEERFLOW_POSTGRES_IMAGE_SHA256=
FLOWISE_POSTGRES_IMAGE_REPOSITORY=
FLOWISE_POSTGRES_IMAGE_SHA256=
MODEL_GATEWAY_IMAGE_REPOSITORY=
MODEL_GATEWAY_IMAGE_SHA256=
DEERFLOW_IMAGE_REPOSITORY=
DEERFLOW_IMAGE_SHA256=
FLOWISE_IMAGE_REPOSITORY=
FLOWISE_IMAGE_SHA256=
FLOWISE_WORKER_IMAGE_REPOSITORY=
FLOWISE_WORKER_IMAGE_SHA256=

DEERFLOW_ADAPTER_URL=http://deerflow-adapter.internal:8080
DEERFLOW_INSTANCE_ID=
DEERFLOW_CLOUD_PROVIDER_ID=kimi
DEERFLOW_MODEL_ID=
DEERFLOW_MODEL_BASE_URL=http://model-gateway.service.internal:8090/v1
DEERFLOW_MODEL_CREDENTIAL_VERSION=

FLOWISE_ADAPTER_URL=http://flowise-adapter.internal:8080
FLOWISE_INSTANCE_ID=
FLOWISE_WORKSPACE_ID=
FLOWISE_READINESS_WORKFLOW_ID=

DEERFLOW_DB_PASSWORD_FILE=
FLOWISE_DB_PASSWORD_FILE=
DEERFLOW_REDIS_PASSWORD_FILE=
FLOWISE_REDIS_PASSWORD_FILE=
DEERFLOW_MODEL_GATEWAY_TOKEN_FILE=
DEERFLOW_MODEL_PROVIDER_API_KEY_FILE=
DEERFLOW_INTERNAL_TOKEN_FILE=
DEERFLOW_ADAPTER_TOKEN_FILE=
FLOWISE_ADAPTER_TOKEN_FILE=
FLOWISE_API_KEY_FILE=
FLOWISE_ENCRYPTION_KEY_FILE=
FLOWISE_JWT_AUTH_SECRET_FILE=
FLOWISE_JWT_REFRESH_SECRET_FILE=
FLOWISE_SESSION_SECRET_FILE=
FLOWISE_TOKEN_HASH_SECRET_FILE=
AGENT_FRAMEWORK_CAPABILITY_SECRET_FILE=
