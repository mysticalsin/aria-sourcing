# Production image for Aria Sourcing (Next.js App Router, standalone output).
# The build runs INSIDE the container so the host `.next` (OneDrive-synced, prone to
# mid-write corruption) never enters the image. The dev `Dockerfile` (npm run dev,
# NODE_ENV=development) is NOT for production — it disables every fail-closed guard.
FROM node:22-bookworm-slim@sha256:53ada149d435c38b14476cb57e4a7da73c15595aba79bd6971b547ceb6d018bf AS deps
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM node:22-bookworm-slim@sha256:53ada149d435c38b14476cb57e4a7da73c15595aba79bd6971b547ceb6d018bf AS builder
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
# The 4 NEXT_PUBLIC_* values are inlined into the client bundle by `next build`, so
# they must be ENV *before* the build. They are build args, not runtime secrets (the
# anon key is a public, RLS-guarded JWT). Real tenant builds with DEMO_LOGIN=false.
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN
ARG NEXT_PUBLIC_ENABLE_DEMO_LOGIN
ARG NEXT_PUBLIC_ENABLE_AZURE_LOGIN
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL \
    NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY \
    NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=$NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN \
    NEXT_PUBLIC_ENABLE_DEMO_LOGIN=$NEXT_PUBLIC_ENABLE_DEMO_LOGIN \
    NEXT_PUBLIC_ENABLE_AZURE_LOGIN=$NEXT_PUBLIC_ENABLE_AZURE_LOGIN
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM gcr.io/distroless/nodejs22-debian13:nonroot@sha256:a2723a2817c5b01b8e7b98d567bc8b5a6b0e713e25bfb0a82b6ade4b9db06f50 AS runner
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 NEXT_TELEMETRY_DISABLED=1
# output:"standalone" emits a self-contained server at .next/standalone/server.js but
# EXCLUDES public/ and .next/static — copy them explicitly or every static asset 404s.
COPY --from=builder --chown=65532:65532 /app/public ./public
COPY --from=builder --chown=65532:65532 /app/.next/standalone ./
COPY --from=builder --chown=65532:65532 /app/.next/static ./.next/static
COPY --from=builder --chown=65532:65532 /app/scripts/apollo-authority-cleanup-worker.mjs ./scripts/apollo-authority-cleanup-worker.mjs
COPY --from=builder --chown=65532:65532 /app/scripts/agent-framework-heartbeat-worker.mjs ./scripts/agent-framework-heartbeat-worker.mjs
COPY --from=builder --chown=65532:65532 /app/scripts/sourcing-loop-worker.mjs ./scripts/sourcing-loop-worker.mjs
COPY --from=builder --chown=65532:65532 /app/scripts/sourcing-loop-handlers ./scripts/sourcing-loop-handlers
COPY --from=builder --chown=65532:65532 /app/src/lib/agents/framework/configuration-core.mjs ./src/lib/agents/framework/configuration-core.mjs
COPY --from=builder --chown=65532:65532 /app/src/lib/observability ./src/lib/observability
USER 65532:65532
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
  CMD ["/nodejs/bin/node", "-e", "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
# Distroless supplies `/nodejs/bin/node` as ENTRYPOINT. CMD and Fly process
# values are therefore script arguments, not shell commands.
CMD ["server.js"]
