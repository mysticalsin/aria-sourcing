<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_aria" model="res.groups.privilege">
        <field name="name">Aria</field>
        <field name="sequence">46</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_dna_integration" model="res.groups">
        <field name="name">DNA integration</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_aria"/>
        <field name="comment">Can record the DNA integration status and choose the DNA adapter. Recruiters cannot.</field>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_dna_integration'))]"/>
    </record>

    <record id="aria_transition_audit_company_rule" model="ir.rule">
        <field name="name">Aria transition audit multi-company</field>
        <field name="model_id" ref="model_aria_recruitment_transition_audit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
