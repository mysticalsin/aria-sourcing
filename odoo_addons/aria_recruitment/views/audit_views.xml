<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aria_transition_audit_list" model="ir.ui.view">
        <field name="name">aria.recruitment.transition.audit.list</field>
        <field name="model">aria.recruitment.transition.audit</field>
        <field name="arch" type="xml">
            <list string="Transition audit" create="0" edit="0" delete="0">
                <field name="transitioned_at"/>
                <field name="user_id"/>
                <field name="applicant_id"/>
                <field name="applicant_res_id"/>
                <field name="from_stage_key"/>
                <field name="to_stage_key"/>
                <field name="result"/>
                <field name="reason"/>
                <field name="sudo_used"/>
            </list>
        </field>
    </record>

    <record id="view_aria_transition_audit_form" model="ir.ui.view">
        <field name="name">aria.recruitment.transition.audit.form</field>
        <field name="model">aria.recruitment.transition.audit</field>
        <field name="arch" type="xml">
            <form string="Transition audit" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="transitioned_at"/>
                        <field name="user_id"/>
                        <field name="sudo_used"/>
                        <field name="applicant_id"/>
                <field name="applicant_res_id"/>
                        <field name="from_stage_id"/>
                        <field name="to_stage_id"/>
                        <field name="from_stage_key"/>
                        <field name="to_stage_key"/>
                        <field name="result"/>
                        <field name="reason"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_transition_audit" model="ir.actions.act_window">
        <field name="name">Transition audit</field>
        <field name="res_model">aria.recruitment.transition.audit</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_aria_transition_audit"
        name="Transition audit"
        parent="hr_recruitment.menu_hr_recruitment_root"
        action="action_transition_audit"
        sequence="80"
        groups="hr_recruitment.group_hr_recruitment_user"/>
</odoo>
