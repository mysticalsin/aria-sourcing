REM Copy this file to .env.cmd and edit tokens before Start-OpenBot.bat
set SUPERVISOR_TOKEN=aria-supervisor-dev
set COMPUTER_TOKEN=aria-computer-dev
set OPENBOT_SUPERVISOR_PORT=18765
set OPENBOT_PUBLIC_BASE=http://127.0.0.1:18765
set OPENBOT_HEADED=1
set OPENBOT_MAX_COMPUTERS=5
REM Optional: pin Chrome instead of Playwright Chromium
REM set OPENBOT_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
REM Optional: profile root (defaults to %TEMP%\aria-openbot\profiles)
REM set OPENBOT_PROFILE_ROOT=%USERPROFILE%\aria-openbot\profiles
