.env*

# Next's distDir always resolves via path.join(projectRoot, distDir) even when
# NEXT_DIST_DIR is an absolute path (e.g. $TMPDIR) -- it lands nested in here
# instead of truly outside the repo. Ignore defensively so it can never be committed.
var/

production-readiness/.fly-secrets.env
production-readiness/.fly-token.env
aria-mark.png

# operational one-off admin setup helper (reads gitignored secrets)
set-admin-password.sh

# Claude Code machine-local state. Registered worktrees here also inflate the
# Bash sandbox profile (one deny rule each) until they are pruned, so they must
# never be shared between checkouts.
.claude/launch.json
.claude/worktrees/
.claude/.cc-writes/
