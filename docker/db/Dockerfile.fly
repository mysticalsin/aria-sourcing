# aria-db image: Supabase Postgres plus first-init and post-base reconciliation.
# Top-level 00-* policy runs before migrate.sh. The pinned migrate.sh invokes
# /etc/postgresql.schema.sql directly as supabase_admin after every bundled
# migration, which is the only safe fresh-cluster point for owner-local ACLs and
# split credentials. The init-complete marker remains last and fail-closed.
FROM supabase/postgres:17.6.1.136@sha256:f371b5f3f2ac0a05703f33d6e6134515fb2498cab708fb948a0aeb7481467c00
# /var/lib/postgresql is both the durable volume root and postgres HOME.
# Configure every process, including Fly SSH consoles, to keep history off the
# volume; the entrypoint also removes known regular history files defensively.
ENV HISTFILE=/dev/null \
  PSQL_HISTORY=/dev/null \
  LESSHISTFILE=-
COPY docker/db/entrypoint.fly.sh /usr/local/bin/aria-db-entrypoint
COPY docker/db/00-aria-init-log-policy.sql /docker-entrypoint-initdb.d/00-aria-init-log-policy.sql
COPY docker/db/mark-init-complete.sh /docker-entrypoint-initdb.d/zz-aria-init-complete.sh
COPY docker/bootstrap/supabase-admin-reconciliation.sql /opt/aria/supabase-admin-reconciliation.sql
COPY docker/db/postgresql.schema.sql /etc/postgresql.schema.sql
RUN chmod 0755 \
  /usr/local/bin/aria-db-entrypoint \
  /docker-entrypoint-initdb.d/zz-aria-init-complete.sh
ENTRYPOINT ["/usr/local/bin/aria-db-entrypoint"]
CMD ["postgres", "-D", "/etc/postgresql"]
