# Aria API gateway: the single Supabase origin supabase-js expects.
# /auth/v1/* goes to GoTrue and /rest/v1/* to PostgREST. Like the Kong config it
# replaces, it requires the anon or service key on every API call, turns a bare
# key into the Authorization bearer, and answers CORS. Nothing else is routed.
# Upstreams default to the compose service names; tests can point them elsewhere.
{
	admin off
	auto_https off
	persist_config off
	# The public edge (:8080) sits behind ngrok, on the compose network: keep
	# the X-Forwarded-Proto/Host it sends, so the app sees the https origin the
	# visitor's browser addressed (src/lib/api/same-origin-json.ts).
	servers :8080 {
		trusted_proxies static private_ranges
	}
}

# Upstream connections: one fresh connection per request. Reusing a pooled
# keep-alive connection that the upstream had just closed answered an
# intermittent 502 in ~2 ms (seen on POST /rest/v1/rpc, 2026-11-09), and a POST
# is rightly never replayed on a used connection (it could write twice). A new
# connection inside the Docker network costs well under a millisecond, and a
# connection that cannot be opened is retried safely.
(upstream_resilience) {
	transport http {
		keepalive off
	}
	lb_retries 2
	lb_try_interval 100ms
}

:8000 {
	# 5xx answers only (access entries at ERROR level), so a gateway failure
	# shows in `docker logs aria-sourcing-gateway-1`.
	log {
		output stderr
		level ERROR
	}

	route {
		respond /gateway-health 200

		# A CORS preflight carries no key: answer it before the key check.
		@preflight method OPTIONS
		header @preflight {
			Access-Control-Allow-Origin "*"
			Access-Control-Allow-Methods "GET, HEAD, PUT, PATCH, POST, DELETE, OPTIONS"
			Access-Control-Allow-Headers "{http.request.header.Access-Control-Request-Headers}"
			Access-Control-Max-Age "3600"
		}
		respond @preflight 204

		# The browser opens GoTrue's email-link, OAuth and JWKS routes without a key.
		@missingKey {
			path /auth/v1/* /rest/v1/*
			not path /auth/v1/verify* /auth/v1/callback* /auth/v1/authorize* /auth/v1/.well-known/jwks.json
			not header apikey {$SUPABASE_ANON_KEY}
			not header apikey {$SUPABASE_SERVICE_KEY}
			not query apikey={$SUPABASE_ANON_KEY}
			not query apikey={$SUPABASE_SERVICE_KEY}
		}
		header @missingKey {
			Access-Control-Allow-Origin "*"
			Content-Type "application/json"
		}
		respond @missingKey `{"message":"Invalid authentication credentials"}` 401

		# Without a user session the key itself is the role's JWT (anon or service_role).
		@keyWithoutSession {
			header apikey *
			not header Authorization *
		}
		request_header @keyWithoutSession Authorization "Bearer {http.request.header.apikey}"

		handle_path /auth/v1/* {
			reverse_proxy {$AUTH_UPSTREAM:auth:9999} {
				header_down Access-Control-Allow-Origin "*"
				import upstream_resilience
			}
		}
		handle_path /rest/v1/* {
			reverse_proxy {$REST_UPSTREAM:rest:3000} {
				header_down Access-Control-Allow-Origin "*"
				import upstream_resilience
			}
		}
		respond 404
	}

	# An upstream that is down answers 502/504 with the CORS header, so the
	# browser shows the real status instead of an opaque CORS failure.
	handle_errors {
		header Access-Control-Allow-Origin "*"
		header Content-Type "application/json"
		respond `{"message":"API gateway: {err.status_code} {err.status_text}"}`
	}
}

# Public edge for a demo URL (ngrok, `docker compose --profile tunnel`): ONE
# origin for the app and its Supabase API, so a browser on another machine
# never needs localhost (src/lib/supabase/config.ts browserSupabaseUrl).
# /auth/v1 and /rest/v1 go through the gateway above, with its key check; the
# rest goes to the app. What a visitor never needs is closed here: account
# creation and GoTrue admin, the one-click owner login, the agents runner and
# cron clocks, webhooks, the careers board (owner workspace), and any request
# carrying the service key.
:8080 {
	log {
		output stderr
		level ERROR
	}

	route {
		respond /edge-health 200

		@closed path /auth/v1/signup* /auth/v1/admin/* /auth/v1/invite* /auth/v1/otp* /auth/v1/magiclink* /api/auth/demo-login* /api/agent/tick* /api/cron/* /api/webhooks/* /api/careers* /careers*
		respond @closed 404

		@serviceKeyHeader header apikey {$SUPABASE_SERVICE_KEY}
		respond @serviceKeyHeader 403
		@serviceKeyBearer header Authorization "Bearer {$SUPABASE_SERVICE_KEY}"
		respond @serviceKeyBearer 403
		@serviceKeyQuery query apikey={$SUPABASE_SERVICE_KEY}
		respond @serviceKeyQuery 403

		# The LinkedIn extension, zipped for testers (docs/ngrok-demo.md). This one file only.
		@extensionZip path /downloads/aria-linkedin-bridge.zip
		file_server @extensionZip {
			root /srv
		}

		@supabaseApi path /auth/v1/* /rest/v1/*
		reverse_proxy @supabaseApi 127.0.0.1:8000 {
			import upstream_resilience
		}

		reverse_proxy {$APP_UPSTREAM:app:3000} {
			# Server-sent events (/api/linkedin/stream) are passed on as they come.
			flush_interval -1
			import upstream_resilience
		}
	}
}
