# aria-bootstrap: one-off owner reconciliation and migrations runner for the
# real tenant. Fly has no bind mounts, so every reviewed SQL surface is copied
# into the immutable image. Build context = repo root.
FROM postgres:17-bookworm@sha256:5530681ea5d3e2ed4ce396f9b5cb443efbac6baf2a8a19c0c0635e40ae7eadce
# Patch upstream-fixable CVEs at build time (Debian patch upgrades only) and drop
# gosu: this image is a psql client whose entrypoint below never starts postgres,
# so the base image's root-drop helper (a Go binary carrying fixable Go-stdlib
# CVEs) is dead weight in the scan surface.
RUN apt-get update \
  && apt-get upgrade -y \
  && rm -rf /var/lib/apt/lists/* \
  && rm -f /usr/local/bin/gosu
COPY docker/bootstrap/run.fly.sh /usr/local/bin/run.fly.sh
COPY supabase/migrations         /migrations
COPY docker/bootstrap/supabase-admin-reconciliation.sql /opt/aria/supabase-admin-reconciliation.sql
COPY docker/bootstrap/auth-owner-bridges.sql /opt/aria/auth-owner-bridges.sql
COPY docker/bootstrap/legacy-baseline-invariants.sql /opt/aria/legacy-baseline-invariants.sql
COPY docker/bootstrap/legacy-table-inventory.txt /opt/aria/legacy-table-inventory.txt
COPY docker/bootstrap/legacy-baseline-public-schema.sha256 /opt/aria/legacy-baseline-public-schema.sha256
COPY docker/bootstrap/recovery-empty-public-schema.sha256 /opt/aria/recovery-empty-public-schema.sha256
RUN chmod +x /usr/local/bin/run.fly.sh
USER postgres
ENTRYPOINT ["/usr/local/bin/run.fly.sh"]
