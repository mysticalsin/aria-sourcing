{
  "name": "hermes-sourcing",
  "version": "1.0.0",
  "private": true,
  "description": "ARIA recruiting operations platform with guarded sourcing agents, tenant-scoped memory, and audited outreach.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:isolated": "node scripts/build-isolated.mjs",
    "start": "next start",
    "docker:dev": "docker compose up",
    "docker:build": "docker compose up --build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --pretty false",
    "test:candidate-erasure": "node scripts/run-test-manifest.mjs --group candidate-erasure",
    "test:db-candidate-erasure": "bash tests/candidate-erasure-db.sh",
    "test:db-candidates-corpus": "bash tests/candidates-corpus-db.sh",
    "test:db-person-model": "bash tests/person-model-db.sh",
    "test:db-loop-jobs": "bash tests/loop-jobs-db.sh",
    "test:db-agent-operational-rollback": "bash tests/agent-operational-authority-rollback-db.sh",
    "posttest": "node scripts/run-test-manifest.mjs --group posttest",
    "test:agent-framework-adapter": "node scripts/run-test-manifest.mjs --group framework-adapter",
    "test:agent-framework": "node scripts/run-test-manifest.mjs --group framework",
    "pretest": "node scripts/run-test-manifest.mjs --group pretest",
    "test": "node scripts/run-test-manifest.mjs --group application",
    "test:security": "node scripts/run-test-manifest.mjs --group security",
    "test:obscura": "node scripts/run-test-manifest.mjs --group obscura",
    "test:db-privileges": "bash scripts/test-db-privileges.sh",
    "test:db-cross-channel-cap": "bash tests/cross-channel-cap-postgres.sh",
    "test:db-sequence-engine": "bash tests/sequence-engine-db.sh",
    "test:db-agent-memory": "bash tests/agent-memory-db.sh",
    "test:db-apollo-enrichment": "bash tests/apollo-enrichment-db.sh",
    "test:db-sourcing-learning": "bash tests/sourcing-learning-db.sh",
    "test:db-conversation-authority": "bash tests/conversation-authority-db.sh",
    "test:db-agent-framework": "bash tests/agent-framework-authority-db.sh && bash tests/agent-framework-provisioning-db.sh",
    "test:owner-recovery": "node scripts/run-test-manifest.mjs --group owner-recovery",
    "test:db-owner-recovery": "bash tests/orphan-owner-recovery-db.sh",
    "test:graphify-learning": "bash tests/graphify-learning-container.sh",
    "run:graphify-learning": "node scripts/run-sourcing-learning.mjs",
    "agent-framework:authority": "node scripts/provision-agent-framework-authority.mjs",
    "configure:graphify-learning": "node scripts/configure-sourcing-learning.mjs",
    "review:graphify-learning": "node scripts/review-sourcing-lesson.mjs",
    "test:fly-db-volume": "bash scripts/test-fly-db-volume.sh",
    "test:manifest": "tsx tests/test-manifest-contract.mts",
    "test:all": "node scripts/run-test-manifest.mjs --group all",
    "test:database": "node scripts/run-test-manifest.mjs --group database",
    "test:recovery": "node scripts/run-test-manifest.mjs --group recovery",
    "test:authority-regression": "node scripts/run-test-manifest.mjs --group authority-regression"
  },
  "dependencies": {
    "@langchain/core": "^0.3.80",
    "@langchain/langgraph": "^0.2.74",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.108.2",
    "@visx/event": "^4.0.0",
    "@visx/geo": "^4.0.0",
    "@visx/responsive": "^4.0.0",
    "@visx/zoom": "^4.0.0",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.456.0",
    "next": "^16.2.6",
    "playwright-core": "^1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-use-measure": "^2.1.7",
    "recharts": "^2.13.3",
    "server-only": "0.0.1",
    "tailwind-merge": "^2.5.4",
    "three": "^0.169.0",
    "three-stdlib": "^2.36.1",
    "topojson-client": "^3.1.0",
    "troika-three-text": "^0.52.4",
    "world-atlas": "^2.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20.17.6",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.169.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.6",
    "js-yaml": "4.3.0",
    "playwright": "^1.61.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.16"
    }
  }
}
