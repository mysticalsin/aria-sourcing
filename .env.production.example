# =============================================================================
# Hermes Sourcing — production environment variables
# Copy to the Vercel dashboard (Settings → Environment Variables) or to
# .env.production.local for a self-hosted Node deployment.
#
# WITHOUT the Supabase block the app runs in DEMO mode (localStorage, no login).
# WITH the Supabase block it runs in LIVE mode (Supabase persistence + Entra SSO).
# All email sends remain dry-run until a fleet seat is explicitly flipped live.
#
# NEVER commit actual secrets. This file contains placeholder values only.
# =============================================================================


# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# Required for live mode. Omit to stay in demo mode.
# ---------------------------------------------------------------------------

# Public project URL — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon public key — safe to expose to the browser; RLS enforces row security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ANON_KEY_PLACEHOLDER

# Service-role key — server-side only. NEVER ship to the browser. Used for
# admin operations (migrations, key vault reads, suppression-list writes).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.SERVICE_ROLE_KEY_PLACEHOLDER


# ---------------------------------------------------------------------------
# Email domain restriction — optional but strongly recommended
# Restricts Supabase Auth sign-in to one corporate domain. Shown on the
# login screen; hard enforcement requires single-tenant Azure or Supabase
# auth hooks (see SUPABASE_SETUP.md §7).
# ---------------------------------------------------------------------------

NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=yourcompany.com


# ---------------------------------------------------------------------------
# Gmail OAuth — server-side only
# Required to send outreach via Gmail seats. Register credentials at
# https://console.cloud.google.com/apis/credentials (OAuth client ID, Web app).
# Enable the Gmail API. Add your production redirect URI to the allowed list.
# ---------------------------------------------------------------------------

GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-PLACEHOLDER_SECRET
# Must match the URI registered in Google Cloud Console exactly.
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/auth/google/callback


# ---------------------------------------------------------------------------
# Microsoft Graph OAuth — server-side only
# Required to send outreach via Outlook/Exchange Online seats.
# Register at Azure Portal → Entra ID → App registrations.
# Grant delegated permissions: Mail.Send, User.Read, offline_access.
# ---------------------------------------------------------------------------

MICROSOFT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MICROSOFT_CLIENT_SECRET=PLACEHOLDER~MicrosoftSecretValue.ChangeMe
# Must match the URI registered in Azure App registration exactly.
MICROSOFT_REDIRECT_URI=https://your-app.vercel.app/auth/microsoft/callback


# ---------------------------------------------------------------------------
# Transactional email providers — server-side only, both optional
# At most one is needed. If both are set, Resend takes precedence in the
# provider selection logic. Leave blank to keep all sends in dry-run mode.
# Complete SPF/DKIM/DMARC domain verification before flipping any seat live.
# ---------------------------------------------------------------------------

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_PLACEHOLDER_ChangeMe

# SendGrid API key — https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.PLACEHOLDER_ChangeMe.PLACEHOLDER_ChangeMe


# ---------------------------------------------------------------------------
# Hermes agent runtime — server-side only
# Base URL of the hermes-agent OpenAI-compatible inference server.
# In production this must be a private/internal endpoint (not public internet).
# HERMES_API_KEY is a strong random token you generate and set on the server.
# ---------------------------------------------------------------------------

# Internal URL of the running hermes-agent process.
HERMES_API_URL=http://127.0.0.1:8642

# Bearer token the Next.js API routes use to authenticate with hermes-agent.
# Generate with: openssl rand -hex 32
HERMES_API_KEY=PLACEHOLDER_generate_with_openssl_rand_hex_32
