# MSourcing / ARIA production environment example
# Copy these names to Vercel or `.env.production.local`.
# Placeholders only. Never commit real secrets.

# REQUIRED LIVE PROD: browser Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# REQUIRED LIVE PROD: browser Supabase anon key; RLS must be active.
NEXT_PUBLIC_SUPABASE_ANON_KEY=PLACEHOLDER_SUPABASE_ANON_KEY

# OPTIONAL: server-side Supabase URL override; defaults to NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=

# REQUIRED LIVE PROD: server-only Supabase service-role key.
SUPABASE_SERVICE_ROLE_KEY=PLACEHOLDER_SUPABASE_SERVICE_ROLE_KEY

# REQUIRED LIVE PROD: base64 32-byte key for provider/OAuth encryption at rest.
DATA_ENCRYPTION_KEY=PLACEHOLDER_generate_with_openssl_rand_base64_32

# OPTIONAL DURING ROTATION: JSON array of prior canonical base64 32-byte keys.
DATA_ENCRYPTION_PREVIOUS_KEYS=

# RECOMMENDED LIVE PROD: allowed auth email domain.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=yourcompany.com

# MUST BE UNSET/FALSE IN LIVE PROD: synthetic demo-login escape hatch.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false
NEXT_PUBLIC_ENABLE_AZURE_LOGIN=false

# REQUIRED ONLY IF DEMO LOGIN IS ENABLED: HMAC secret for signed demo sessions.
DEMO_SESSION_SECRET=

# REQUIRED ONLY IF DEMO LOGIN IS ENABLED: demo admin password.
DEMO_ADMIN_PASSWORD=

# REQUIRED LIVE PROD: bearer secret for /api/cron/dispatch-outbound.
CRON_SECRET=PLACEHOLDER_generate_with_openssl_rand_hex_32

# REQUIRED LIVE EMAIL: canonical HTTPS app origin for unsubscribe URLs.
OUTREACH_UNSUBSCRIBE_BASE_URL=https://your-app.vercel.app

# REQUIRED FOR /careers: workspace UUID allowed to publish public roles.
CAREERS_WORKSPACE_ID=

# OPTIONAL SOURCING: GitHub token for read-only source search.
GITHUB_TOKEN=

# OPTIONAL SOURCING: Tavily web sourcing key; stored workspace key can take precedence.
TAVILY_API_KEY=

# MUST REMAIN FALSE: third-party MCP tool execution is disabled in production code.
ARIA_ENABLE_REMOTE_MCP_EXECUTION=false

# REQUIRED IF DATABRICKS INTAKE IS ENABLED: comma-separated exact canonical HTTPS workspace origins.
# Stored Databricks credentials are never sent when this deployment-owned allowlist is empty.
DATABRICKS_ALLOWED_ORIGINS=https://your-workspace.cloud.databricks.com

# REQUIRED IF HERMES ENABLED: private/internal Hermes aiohttp gateway URL.
# Serves /health, /v1/* and /api/sessions.
# The host must ALSO be named in HERMES_ALLOWED_HOSTS below or every request is
# refused by the SSRF allow-list before it is sent.
HERMES_API_URL=

# REQUIRED IF HERMES ENABLED: private/internal Hermes management server URL — a
# SEPARATE upstream process (`hermes_cli.main web`, default port 8080) serving
# /api/status, /api/system/stats, /api/config, /api/memory, /api/skills,
# /api/curator and /api/files. No fallback to HERMES_API_URL: the gateway does
# not register these routes.
HERMES_WEB_URL=

# REQUIRED IF HERMES ENABLED: comma-separated list of EXACT hostnames the
# deployment may reach for the Hermes runtime. The built-in allow-list only
# covers loopback and RFC1918, so a private-DNS deployment (for example Fly
# `<app>.internal` names on 6PN) must name its hosts here or the runtime is
# unreachable and every call silently falls back to the deterministic mock.
# Exact hostnames or IP literals only — wildcards, schemes and paths are ignored.
# Cloud metadata endpoints stay blocked even if named.
# Example: HERMES_ALLOWED_HOSTS=aria-mantu-hermes.internal
HERMES_ALLOWED_HOSTS=

# REQUIRED IF HERMES ENABLED: Hermes runtime bearer token.
HERMES_API_KEY=

# REQUIRED IF HERMES PROXY ENABLED: shared proxy secret.
HERMES_PROXY_SECRET=

# REQUIRED IF HERMES ENABLED: workspace UUID bound to the dedicated runtime.
HERMES_RUNTIME_WORKSPACE_ID=

# REQUIRED AGENT FRAMEWORKS. Each endpoint is an ARIA-owned private adapter;
# never point these variables at the broad DeerFlow Gateway or public Flowise.
# Enable only after both exact images, tenant isolation, and readiness pass.
AGENT_FRAMEWORKS_REQUIRED=true
AGENT_FRAMEWORK_EXECUTION_ENABLED=false
AGENT_FRAMEWORK_KILL_SWITCH=true
AGENT_FRAMEWORK_CONFIGURATION_SHA256=
AGENT_FRAMEWORK_CAPABILITY_SECRET=
AGENT_FRAMEWORK_READINESS_WORKSPACE_ID=
FRAMEWORK_ADAPTER_IMAGE_DIGEST=
REDIS_IMAGE_DIGEST=
DEERFLOW_ADAPTER_URL=https://deerflow.service.internal
DEERFLOW_ADAPTER_TOKEN=
DEERFLOW_SOURCE_COMMIT=fabadae4168db81f0eaaf62f209050f978e2f691
DEERFLOW_IMAGE_DIGEST=
DEERFLOW_DATABASE_IMAGE_DIGEST=
DEERFLOW_FRAMEWORK_INSTANCE_ID=
DEERFLOW_MODEL_GATEWAY_IMAGE_DIGEST=
DEERFLOW_CLOUD_PROVIDER_ID=kimi
DEERFLOW_MODEL_PROVIDER=langchain-openai
DEERFLOW_MODEL_ID=
DEERFLOW_MODEL_BASE_URL=http://model-gateway.service.internal:8090/v1
DEERFLOW_MODEL_CREDENTIAL_VERSION=
FLOWISE_ADAPTER_URL=https://flowise.service.internal
FLOWISE_ADAPTER_TOKEN=
FLOWISE_SOURCE_COMMIT=bb773ffa710bd22639c4ba2643413a0ea2b679d3
FLOWISE_IMAGE_DIGEST=
FLOWISE_WORKER_IMAGE_DIGEST=
FLOWISE_DATABASE_IMAGE_DIGEST=
FLOWISE_FRAMEWORK_INSTANCE_ID=
FLOWISE_WORKSPACE_ID=
FLOWISE_READINESS_WORKFLOW_ID=
FLOWISE_TENANT_ISOLATION=instance-per-workspace
FLOWISE_QUEUE_NAME=aria-flowise

# REQUIRED FOR GMAIL SEATS: Google OAuth client ID.
GOOGLE_CLIENT_ID=

# REQUIRED FOR GMAIL SEATS: Google OAuth client secret.
GOOGLE_CLIENT_SECRET=

# REQUIRED FOR GMAIL SEATS: exact Google OAuth redirect URI.
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/auth/google/callback

# REQUIRED FOR MICROSOFT GRAPH SEATS: Azure app client ID.
MICROSOFT_CLIENT_ID=

# REQUIRED FOR MICROSOFT GRAPH SEATS: Azure app client secret.
MICROSOFT_CLIENT_SECRET=

# REQUIRED FOR MICROSOFT GRAPH SEATS: exact Microsoft OAuth redirect URI.
MICROSOFT_REDIRECT_URI=https://your-app.vercel.app/auth/microsoft/callback

# DELIVERY PROVIDER: Resend API key. At least one delivery path is required before live email.
RESEND_API_KEY=

# DELIVERY PROVIDER: SendGrid API key. At least one delivery path is required before live email.
SENDGRID_API_KEY=

# OPTIONAL WHATSAPP: Meta Cloud API token.
WHATSAPP_TOKEN=

# OPTIONAL WHATSAPP: Meta phone number ID.
WHATSAPP_PHONE_NUMBER_ID=

# OPTIONAL WHATSAPP: webhook verification token.
WHATSAPP_VERIFY_TOKEN=

# OPTIONAL WHATSAPP: Meta app secret for webhook signatures.
WHATSAPP_APP_SECRET=

# OPTIONAL WHATSAPP: Graph API version; code defaults to v21.0.
WHATSAPP_API_VERSION=v21.0

# RESERVED: Twilio SMS variables; SMS remains disabled until controls match email/WhatsApp.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# OPTIONAL VOICE: ElevenLabs API key for TTS.
ELEVENLABS_API_KEY=

# OPTIONAL VOICE: ElevenLabs voice ID.
ELEVENLABS_VOICE_ID=

# OPTIONAL RESEARCH SIDECAR: Obscura HTTP endpoint.
OBSCURA_URL=

# OPTIONAL RESEARCH SIDECAR: local Obscura binary path.
OBSCURA_BIN_PATH=

# OPTIONAL CLOUD MODEL FALLBACKS: server-side keys used when no workspace key is stored.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
