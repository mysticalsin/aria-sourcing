# ARIA protected Fly release secret-name template.
# Values are intentionally blank. Never commit a populated copy and never source
# the file as shell code; deploy-fly.sh parses only the allowlisted names below.

# Protected-workflow credentials. FLY_RECOVERY_AUDIT_TOKEN is read-only and can
# list volumes, snapshots, Machines, and IPs only for the source database and
# exact release-scoped restore app. FLY_REGISTRY_TOKEN,
# FLY_AGENT_FRAMEWORK_REGISTRY_TOKEN, and FLY_API_TOKEN are independently
# scoped registry and deployment credentials.
FLY_RECOVERY_AUDIT_TOKEN=
FLY_RECOVERY_CLEANUP_TOKEN=
FLY_REGISTRY_TOKEN=
FLY_AGENT_FRAMEWORK_REGISTRY_TOKEN=
FLY_API_TOKEN=

# Strict JSON generated from volume-recovery-receipt.example.json after a
# successful disposable restore drill. This owner-approved receipt is release
# specific, expires in at most four hours, and is live-checked before builds or
# production mutation.
ARIA_VOLUME_RECOVERY_RECEIPT_JSON=
ARIA_VOLUME_RESTORE_CREATE_REQUEST_JSON=
ARIA_VOLUME_RESTORE_CREATE_RESPONSE_JSON=

# Normally absent. For a genuine first deployment with no prior image digest,
# the owner may install exactly aria-first-deploy-v1:<release-sha>:<receipt-sha>.
# Remove it immediately after that one release.
ARIA_FIRST_DEPLOY_APPROVAL=

# Protected environment variable, not a secret. Normally absent. If live
# inventory proves there is no real administrator, set it to exactly
# aria-admin-bootstrap-v1:<release-sha>:<recovery-receipt-sha>. Remove it after
# the run; an existing administrator makes any stale value fail closed.
ARIA_ADMIN_BOOTSTRAP_APPROVAL=

# Required only with the exact administrator-bootstrap approval above. The
# workflow creates and verifies the real tenant administrator regardless of
# prior image history, then these two secrets must be removed. Later releases
# verify the existing admin profile and reject stale bootstrap credentials.
ARIA_FIRST_ADMIN_EMAIL=
ARIA_FIRST_ADMIN_PASSWORD=

# Existing direct supabase_admin credential. During steady state this can equal
# the target owner credential. During a reviewed rotation it is the old value.
FLY_SUPABASE_ADMIN_CURRENT_PASSWORD=

# Four distinct 43-128 character base64url database target credentials.
FLY_SUPABASE_ADMIN_TARGET_PASSWORD=
FLY_PG_PASSWORD=
FLY_AUTH_DB_PASSWORD=
FLY_REST_DB_PASSWORD=

# 43-128 character base64url HS256 secret. Regenerating it also requires new
# matching anon and service-role JWTs; deploy-fly.sh verifies both signatures.
FLY_JWT_SECRET=
FLY_SUPABASE_ANON_KEY=
FLY_SUPABASE_SERVICE_KEY=

# Application encryption and cron authorization secrets.
FLY_DATA_ENCRYPTION_KEY=
# Optional JSON array of up to eight prior canonical base64 32-byte keys.
FLY_DATA_ENCRYPTION_PREVIOUS_KEYS=
# Required only to retire a deployed previous-key ring. Bind to exact release
# and recovery receipt; remove immediately after the reviewed run.
ARIA_DATA_KEY_RING_RETIREMENT_APPROVAL=
FLY_CRON_SECRET=

# Independent internal execution authorities. Each value must be unique and
# contain 32-4096 non-whitespace characters; do not reuse a JWT, encryption,
# database, provider, or cron secret.
FLY_REQUISITION_PARSE_SECRET=
FLY_SOURCING_EXECUTION_SECRET=
FLY_AGENT_FRAMEWORK_CAPABILITY_SECRET=
FLY_DEERFLOW_ADAPTER_TOKEN=
FLY_FLOWISE_ADAPTER_TOKEN=

# Required aggregate OpenTelemetry export. Headers are collector-specific
# secret material and the endpoint must use an approved HTTPS collector.
FLY_OTEL_EXPORTER_OTLP_ENDPOINT=
FLY_OTEL_EXPORTER_OTLP_HEADERS=

# Optional provider credentials. Autonomous Tavily execution still requires a
# separately verified, workspace-bound credential row and activation proof.
TAVILY_API_KEY=
ARIA_GITHUB_SOURCE_TOKEN=
KIMI_API_KEY=
KIMI_BASE_URL=
ANTHROPIC_API_KEY=

# Protected need-ingress throttle and sourcing-activation environments. These
# values are release-scoped proof inputs, not application-wide fallbacks.
ARIA_NEED_INGRESS_THROTTLE_EVIDENCE_HMAC_KEY=
ARIA_NEED_INGRESS_THROTTLE_EVIDENCE_JSON=
ARIA_SOURCING_CANARY_EMAIL=
ARIA_SOURCING_CANARY_PASSWORD=
ARIA_SOURCING_CANARY_NEED_KEY=
