# Owner-only Azure / Graph credentials for Fly enterprise E2E.
# Copy to /tmp/owner-microsoft.env OR production-readiness/.owner-microsoft.env
# (gitignored), fill real values, then:
#   bash scripts/fly-apply-owner-microsoft-secrets.sh
#
# Graph-minimum (required for E2E PASS / verify-m365-ready):
#   MICROSOFT_CLIENT_ID, MICROSOFT_CLIENT_SECRET, MICROSOFT_TENANT_ID
#   (+ REDIRECT_URI below)
# Entra GoTrue lines below are OPTIONAL for Graph/Outlook PASS — leave as
# PLACEHOLDER to skip SSO apply (apply script is Graph-first / Entra all-or-none).
#
# NEVER commit real values. PLACEHOLDER values are refused by the apply script.
#
# If az login cannot CREATE app registrations, create one in Azure Portal then:
#   export ARIA_AZURE_APP_ID='<client-id>'
#   bash scripts/az-configure-existing-graph-app.sh --apply

MICROSOFT_CLIENT_ID=PLACEHOLDER_AZURE_APP_CLIENT_ID
MICROSOFT_CLIENT_SECRET=PLACEHOLDER_AZURE_APP_CLIENT_SECRET
MICROSOFT_REDIRECT_URI=https://aria-mantu-app.fly.dev/auth/microsoft/callback
# Required for single-tenant Graph OAuth (authorize/token must not use /common/).
MICROSOFT_TENANT_ID=ce57ebe3-a63d-4708-b5cf-c274b48bd26c

# Optional — Entra SSO on aria-mantu-auth (not required for Graph E2E PASS).
GOTRUE_EXTERNAL_AZURE_ENABLED=true
GOTRUE_EXTERNAL_AZURE_CLIENT_ID=PLACEHOLDER_AZURE_APP_CLIENT_ID
GOTRUE_EXTERNAL_AZURE_SECRET=PLACEHOLDER_AZURE_APP_CLIENT_SECRET
GOTRUE_EXTERNAL_AZURE_URL=https://login.microsoftonline.com/ce57ebe3-a63d-4708-b5cf-c274b48bd26c/v2.0
