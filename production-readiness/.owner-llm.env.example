# Drop-zone template for LLM keys (never commit real values).
# Copy to /tmp/owner-llm.env or production-readiness/.owner-llm.env then:
#   bash scripts/fly-apply-owner-llm-secrets.sh
#
# Provide at least one real key. Live tip currently uses Kimi at
# https://api.kimi.com/coding/v1 — a 401 means rotate KIMI_API_KEY.

KIMI_API_KEY=PLACEHOLDER_KIMI_KEY
# Optional — leave unset to keep the Fly machine's current base URL
# KIMI_BASE_URL=https://api.kimi.com/coding/v1

# Alternatives (any one unblocks intake/parse/draft via env + vault failover):
# DEEPSEEK_API_KEY=PLACEHOLDER_DEEPSEEK_KEY
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=PLACEHOLDER_OPENAI_KEY
# ANTHROPIC_API_KEY=PLACEHOLDER_ANTHROPIC_KEY
