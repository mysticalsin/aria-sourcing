# ============================================================================
# Hermes Sourcing — environment
# Copy to `.env.local`. With these UNSET the app runs in DEMO mode
# (localStorage, no login). With them SET it runs in LIVE mode
# (Supabase persistence + Microsoft/Entra login required).
# ============================================================================

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used for admin/maintenance scripts. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: restrict sign-in to one email domain (e.g. mantu.com) ---
# Shown on the login screen; actual enforcement is configured in Entra/Supabase.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=

# --- Email send providers (server-only, official APIs) ---
# Present + a seat set LIVE + verified domain + explicit confirm = real send,
# within per-account official limits and the fleet guardrails. Absent = dry-run.
# Microsoft Graph / Gmail need per-mailbox OAuth (connect flow), not a single key.
RESEND_API_KEY=
SENDGRID_API_KEY=

# --- Gmail OAuth (server-only) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Microsoft OAuth (server-only) ---
# Register app at https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
# Redirect URI: http://localhost:3000/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback

# --- Hermes agent runtime (server-only) ---
# Base URL of the local hermes-agent OpenAI-compatible server.
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=

# --- Cloud LLM providers (server-only fallbacks) ---
# Optional. Used as a server-side fallback when a provider has no vault key configured.
# To go live, configure a provider in Settings → AI & Models and store the key there.
# Keys set here bypass the vault; vault keys (set via Settings) always take precedence.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=
