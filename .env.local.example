# MSourcing / ARIA local environment example
# Copy to `.env.local`. Keep values blank to stay in dry-run demo mode.
# Never commit real secrets.

# REQUIRED FOR LIVE LOCAL: browser Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=

# REQUIRED FOR LIVE LOCAL: browser Supabase anon key; RLS must be active.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OPTIONAL: server-side Supabase URL override; defaults to NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=

# REQUIRED FOR LIVE LOCAL: server-only Supabase service-role key.
SUPABASE_SERVICE_ROLE_KEY=

# REQUIRED FOR LIVE LOCAL WITH STORED SECRETS: base64 32-byte key for provider/OAuth encryption at rest.
DATA_ENCRYPTION_KEY=

# OPTIONAL DURING ROTATION: JSON array of up to eight prior canonical base64 32-byte keys.
DATA_ENCRYPTION_PREVIOUS_KEYS=

# RECOMMENDED FOR LIVE LOCAL: allowed auth email domain shown/enforced by auth flow.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=

# OPTIONAL DEMO ONLY: enables signed demo-login path; keep unset for real tenant testing.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=
NEXT_PUBLIC_ENABLE_AZURE_LOGIN=false

# OPTIONAL PREVIEW ONLY: read /candidates listing rows from the server corpus mirror.
# Default false keeps the existing store-backed page path unchanged.
NEXT_PUBLIC_ENABLE_CORPUS_SERVER_READ=false

# OPTIONAL DEMO ONLY: HMAC secret for demo sessions when demo login is enabled.
DEMO_SESSION_SECRET=

# OPTIONAL DEMO ONLY: demo admin password; not for real tenants.
DEMO_ADMIN_PASSWORD=

# REQUIRED FOR DISPATCHER TESTING: bearer secret for /api/cron/dispatch-outbound.
CRON_SECRET=

# REQUIRED FOR LIVE EMAIL: canonical app origin used to generate unsubscribe URLs.
OUTREACH_UNSUBSCRIBE_BASE_URL=

# OPTIONAL: public careers workspace UUID; /careers fails closed when unset.
CAREERS_WORKSPACE_ID=

# OPTIONAL: GitHub sourcing token for read-only source search.
GITHUB_TOKEN=

# OPTIONAL: Tavily web sourcing key; stored workspace key can take precedence.
TAVILY_API_KEY=

# NOTE: Apify (LinkedIn profile search) has no env var. The token is workspace-stored
# and encrypted (Settings -> API Keys, provider "Apify"), read server-side only.

# DEVELOPMENT/TEST ONLY: explicit opt-in for third-party MCP tool execution.
# Default false. Production denies execution even if this value is set to true.
ARIA_ENABLE_REMOTE_MCP_EXECUTION=false

# REQUIRED IF DATABRICKS INTAKE IS ENABLED: comma-separated exact canonical HTTPS workspace origins.
# Leave empty to fail closed and disable credential-bearing Databricks requests.
DATABRICKS_ALLOWED_ORIGINS=

# OPTIONAL: Hermes runtime internal URL.
HERMES_API_URL=http://127.0.0.1:8642

# OPTIONAL: Hermes runtime bearer token.
HERMES_API_KEY=

# OPTIONAL: Hermes proxy shared secret.
HERMES_PROXY_SECRET=

# OPTIONAL WITH HERMES: workspace UUID bound to the dedicated runtime.
HERMES_RUNTIME_WORKSPACE_ID=

# OPTIONAL LOCAL FRAMEWORK PREVIEW. Public proxying remains disabled; both URLs
# must terminate at ARIA-owned private adapters, not the broad upstream APIs.
AGENT_FRAMEWORKS_REQUIRED=false
AGENT_FRAMEWORK_EXECUTION_ENABLED=false
AGENT_FRAMEWORK_KILL_SWITCH=true
AGENT_FRAMEWORK_CONFIGURATION_SHA256=
AGENT_FRAMEWORK_CAPABILITY_SECRET=
AGENT_FRAMEWORK_READINESS_WORKSPACE_ID=
FRAMEWORK_ADAPTER_IMAGE_DIGEST=
REDIS_IMAGE_DIGEST=
DEERFLOW_ADAPTER_URL=
DEERFLOW_ADAPTER_TOKEN=
DEERFLOW_SOURCE_COMMIT=fabadae4168db81f0eaaf62f209050f978e2f691
DEERFLOW_IMAGE_DIGEST=
DEERFLOW_DATABASE_IMAGE_DIGEST=
DEERFLOW_FRAMEWORK_INSTANCE_ID=
DEERFLOW_MODEL_GATEWAY_IMAGE_DIGEST=
DEERFLOW_CLOUD_PROVIDER_ID=kimi
DEERFLOW_MODEL_PROVIDER=langchain-openai
DEERFLOW_MODEL_ID=
DEERFLOW_MODEL_BASE_URL=
DEERFLOW_MODEL_CREDENTIAL_VERSION=
FLOWISE_ADAPTER_URL=
FLOWISE_ADAPTER_TOKEN=
FLOWISE_SOURCE_COMMIT=bb773ffa710bd22639c4ba2643413a0ea2b679d3
FLOWISE_IMAGE_DIGEST=
FLOWISE_WORKER_IMAGE_DIGEST=
FLOWISE_DATABASE_IMAGE_DIGEST=
FLOWISE_FRAMEWORK_INSTANCE_ID=
FLOWISE_WORKSPACE_ID=
FLOWISE_READINESS_WORKFLOW_ID=
FLOWISE_TENANT_ISOLATION=instance-per-workspace
FLOWISE_QUEUE_NAME=aria-flowise

# OPTIONAL: Gmail OAuth client ID for mailbox seats.
GOOGLE_CLIENT_ID=

# OPTIONAL: Gmail OAuth client secret for mailbox seats.
GOOGLE_CLIENT_SECRET=

# OPTIONAL: Gmail OAuth redirect URI.
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# OPTIONAL: Microsoft Graph OAuth client ID for mailbox seats.
MICROSOFT_CLIENT_ID=

# OPTIONAL: Microsoft Graph OAuth client secret for mailbox seats.
MICROSOFT_CLIENT_SECRET=

# OPTIONAL: Microsoft Graph OAuth redirect URI.
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback

# OPTIONAL DELIVERY PROVIDER: Resend API key.
RESEND_API_KEY=

# OPTIONAL DELIVERY PROVIDER: SendGrid API key.
SENDGRID_API_KEY=

# OPTIONAL WHATSAPP: Meta Cloud API token.
WHATSAPP_TOKEN=

# OPTIONAL WHATSAPP: Meta phone number ID.
WHATSAPP_PHONE_NUMBER_ID=

# OPTIONAL WHATSAPP: webhook verification token.
WHATSAPP_VERIFY_TOKEN=

# OPTIONAL WHATSAPP: Meta app secret for webhook signatures.
WHATSAPP_APP_SECRET=

# OPTIONAL WHATSAPP: Graph API version; code defaults to v21.0.
WHATSAPP_API_VERSION=v21.0

# RESERVED: Twilio SMS variables; SMS remains disabled until controls match email/WhatsApp.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# OPTIONAL VOICE: ElevenLabs API key for TTS.
ELEVENLABS_API_KEY=

# OPTIONAL VOICE: ElevenLabs voice ID.
ELEVENLABS_VOICE_ID=

# OPTIONAL RESEARCH SIDECAR: Obscura HTTP endpoint.
OBSCURA_URL=http://127.0.0.1:9222

# OPTIONAL RESEARCH SIDECAR: local Obscura binary path.
OBSCURA_BIN_PATH=

# OPTIONAL CLOUD MODEL FALLBACKS: server-side keys used when no workspace key is stored.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
