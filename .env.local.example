# ============================================================================
# Hermes Sourcing — environment
# Copy to `.env.local`. With these UNSET the app runs in DEMO mode
# (localStorage, no login). With them SET it runs in LIVE mode
# (Supabase persistence + Microsoft/Entra login required).
# ============================================================================

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used for admin/maintenance scripts. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: restrict sign-in to one email domain (e.g. mantu.com) ---
# Shown on the login screen; actual enforcement is configured in Entra/Supabase.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=

# --- Email send providers (server-only, official APIs) ---
# Present + a seat set LIVE + verified domain + explicit confirm = real send,
# within per-account official limits and the fleet guardrails. Absent = dry-run.
# Microsoft Graph / Gmail need per-mailbox OAuth (connect flow), not a single key.
RESEND_API_KEY=
SENDGRID_API_KEY=
