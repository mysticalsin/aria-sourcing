# MSourcing / ARIA local environment example
# Copy to `.env.local`. Keep values blank to stay in dry-run demo mode.
# Never commit real secrets.

# REQUIRED FOR LIVE LOCAL: browser Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=

# REQUIRED FOR LIVE LOCAL: browser Supabase anon key; RLS must be active.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OPTIONAL: server-side Supabase URL override; defaults to NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=

# REQUIRED FOR LIVE LOCAL: server-only Supabase service-role key.
SUPABASE_SERVICE_ROLE_KEY=

# REQUIRED FOR LIVE LOCAL WITH STORED SECRETS: base64 32-byte key for provider/OAuth encryption at rest.
DATA_ENCRYPTION_KEY=

# OPTIONAL DURING ROTATION: JSON array of up to eight prior canonical base64 32-byte keys.
DATA_ENCRYPTION_PREVIOUS_KEYS=

# RECOMMENDED FOR LIVE LOCAL: allowed auth email domain shown/enforced by auth flow.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=

# OPTIONAL DEMO ONLY: enables signed demo-login path; keep unset for real tenant testing.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=
NEXT_PUBLIC_ENABLE_AZURE_LOGIN=false

# OPTIONAL PREVIEW ONLY: read /candidates listing rows from the server corpus mirror.
# Default false keeps the existing store-backed page path unchanged.
NEXT_PUBLIC_ENABLE_CORPUS_SERVER_READ=false

# OPTIONAL DEMO ONLY: HMAC secret for demo sessions when demo login is enabled.
DEMO_SESSION_SECRET=

# OPTIONAL DEMO ONLY: demo admin password; not for real tenants.
DEMO_ADMIN_PASSWORD=

# REQUIRED FOR DISPATCHER TESTING: bearer secret for /api/cron/dispatch-outbound.
CRON_SECRET=

# REQUIRED FOR LIVE EMAIL: canonical app origin used to generate unsubscribe URLs.
OUTREACH_UNSUBSCRIBE_BASE_URL=

# OPTIONAL: public careers workspace UUID; /careers fails closed when unset.
CAREERS_WORKSPACE_ID=

# OPTIONAL: GitHub sourcing token for read-only source search.
GITHUB_TOKEN=

# OPTIONAL: Tavily web sourcing key; stored workspace key can take precedence.
TAVILY_API_KEY=

# EXPERIMENTAL, OFF BY DEFAULT: LinkedIn bridge. The ARIA Chrome extension
# (extensions/linkedin-bridge) syncs your LinkedIn inbox into /linkedin and sends
# the messages you write there, from your own browser session. LinkedIn's User
# Agreement forbids automated access: the account owner carries the risk.
# See docs/linkedin-bridge.md.
LINKEDIN_BRIDGE_ENABLED=false
# Messages per rolling 24 h per LinkedIn account (1-150) and the minimum gap
# between two sends, in seconds (20-3600). Inbox refresh interval (60-3600 s).
LINKEDIN_BRIDGE_DAILY_SEND_CAP=40
LINKEDIN_BRIDGE_MIN_SEND_INTERVAL_SECONDS=90
LINKEDIN_BRIDGE_SYNC_SECONDS=180
# Inbox refresh while an ARIA page with LinkedIn is open and visible (15-600 s).
LINKEDIN_BRIDGE_LIVE_SYNC_SECONDS=30
# Connection invitations per rolling 24 h (1-100) and 7 days (1-200); profile
# reads (relationship checks, counted by LinkedIn as profile views) per 24 h.
LINKEDIN_BRIDGE_DAILY_INVITE_CAP=15
LINKEDIN_BRIDGE_WEEKLY_INVITE_CAP=80
LINKEDIN_BRIDGE_DAILY_LOOKUP_CAP=80
# Campaign autopilot (ADR 0002): only these LinkedIn profiles may be contacted
# by the agent (URLs or public ids, comma-separated). Leave unset for no limit;
# set it for demos and tests so the agent can never reach anyone else.
AGENTS_LINKEDIN_ALLOWLIST=

# DEVELOPMENT/TEST ONLY: explicit opt-in for third-party MCP tool execution.
# Default false. Production denies execution even if this value is set to true.
ARIA_ENABLE_REMOTE_MCP_EXECUTION=false

# OPTIONAL: Gmail OAuth client ID for mailbox seats.
GOOGLE_CLIENT_ID=

# OPTIONAL: Gmail OAuth client secret for mailbox seats.
GOOGLE_CLIENT_SECRET=

# OPTIONAL: Gmail OAuth redirect URI.
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# OPTIONAL: Microsoft Graph OAuth client ID for mailbox seats.
MICROSOFT_CLIENT_ID=

# OPTIONAL: Microsoft Graph OAuth client secret for mailbox seats.
MICROSOFT_CLIENT_SECRET=

# OPTIONAL: Microsoft Graph OAuth redirect URI.
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback

# OPTIONAL DELIVERY PROVIDER: Resend API key.
RESEND_API_KEY=

# OPTIONAL DELIVERY PROVIDER: SendGrid API key.
SENDGRID_API_KEY=

# OPTIONAL HIRE: public HTTPS applicant system. Off unless the URL and token are both set.
# Unset HIRE_CONNECTOR uses Odoo, then SMART, then this API, then MCP.
# HIRE_CONNECTOR=odoo|smart|api|mcp forces one path. The URL must be public HTTPS with no user, password, query, or fragment.
HIRE_API_URL=
HIRE_API_TOKEN=
HIRE_MCP_URL=
HIRE_MCP_TOKEN=
HIRE_MCP_TOOL=
HIRE_CONNECTOR=

# OPTIONAL CLOUD MODEL FALLBACKS: server-side keys used when no workspace key is stored.
# Claude is the default provider. On a developer machine both Anthropic values may
# instead live in the gitignored .secret file (bare key, or KEY=VALUE lines).
ANTHROPIC_API_KEY=
# Required only for a key that is not scoped to an Anthropic workspace (wrkspc_...).
ANTHROPIC_WORKSPACE_ID=
# Claude spend caps in USD per server instance (soft guard; past a cap the app uses
# its non-AI fallbacks). Set the hard limit on the Anthropic workspace as well.
AI_MONTHLY_BUDGET_USD=30
AI_DAILY_BUDGET_USD=6
# Where the spend totals survive restarts. Default: /app/config/ai-usage.json in
# the container (durable volume), var/ai-usage.json in a working tree.
AI_USAGE_FILE=
OPENAI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
